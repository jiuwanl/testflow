FROM registry-1.docker.io/library/eclipse-temurin:21-jdk-jammy@sha256:432e54724c3e57d1846aeb886f4d339f3b0522931c4e64119c2797013b7cfc3c AS build
COPY scripts/fixtures/DemoTarget.java /build/DemoTarget.java
RUN javac -d /build/classes /build/DemoTarget.java
FROM registry-1.docker.io/library/eclipse-temurin:21-jre-jammy@sha256:dff6eb46527bd293a3c06bbbe9e64e8c9f91f01905b5abbdad31761c03059d2c
COPY --from=build /build/classes /app
USER 10001:10001
ENV TF_DEMO_BIND_ADDRESS=0.0.0.0
ENTRYPOINT ["java", "-Xmx96m", "-cp", "/app", "DemoTarget", "8088"]
